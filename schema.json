  "checks": [
    {
      "id": "sourced",
      "applies_to": "all_except_holiday",
      "rule": "source and disclaimer are both required and non-empty",
      "why": "Every claim carries a named outside source and a disclaimer."
    },
    {
      "id": "dated_figures",
      "applies_to": ["market-two-figures", "market-one-figure"],
      "rule": "asof must be present, and source must contain a date or a named week",
      "why": "A figure without the day it was true is presented as current when it is not."
    },
    {
      "id": "no_forecast",
      "applies_to": "all",
      "forbidden_patterns": ["will be", "expect", "heading", "on track to", "poised", "forecast", "predict", "next month will", "by the end of the year"],
      "why": "State what a number was on a named day. Never where it is going."
    },
    {
      "id": "no_bare_quantifiers",
      "applies_to": "all",
      "forbidden_words": ["most", "many", "usually", "typically", "rarely", "often", "generally"],
      "unless": "the same field also names a source",
      "why": "Those are statistics wearing words. Unsourced, they get dropped rather than softened."
    },
    {
      "id": "echo_first_person",
      "applies_to": "all",
      "field": "echo_line",
      "forbidden_patterns": ["you should", "you need to", "you must", "you have to", "I shouldn't", "don't forget to"],
      "why": "Echo says what he would do. Never what you should. Off a licensed agent's account, 'you should' is advice."
    },
    {
      "id": "echo_lands",
      "applies_to": "all",
      "field": "echo_line",
      "rule": "must not end with a question mark",
      "why": "The question is the opening beat. The line closes in understanding."
    },
    {
      "id": "echo_adds_nothing",
      "applies_to": "all",
      "field": "echo_line",
      "rule": "may not contain a figure or claim absent from titan_line",
      "why": "Sounding unsure is not a licence to introduce something unsourced."
    },
    {
      "id": "titan_names_echo",
      "applies_to": "all",
      "field": "titan_line",
      "rule": "must contain 'Echo'",
      "why": "It is a conversation, not two captions. Titan opens by addressing him."
    },
    {
      "id": "home_rows_name_a_pro",
      "applies_to": ["home-walkround", "home-safety"],
      "rule": "every row must contain one of the professionals list",
      "professionals": ["plumber", "electrician", "inspector", "professional", "lender", "contractor", "fire department", "licensed"],
      "why": "The card says what to look at, never what to do. This is the no-verdict rule as a machine check."
    },
    {
      "id": "no_prices",
      "applies_to": "all",
      "forbidden_pattern": "dollar amount attached to a repair, part or service",
      "allowed": "county-wide market figures, sourced and dated",
      "why": "Never quote a price for work. 'About $20' becomes 'worth asking a plumber about'."
    },
    {
      "id": "event_still_ahead",
      "applies_to": ["community-diary", "community-spotlight", "deadline-countdown", "holiday"],
      "rule": "event_date must be later than the scheduled publish time",
      "why": "Anything presented as upcoming must still be upcoming at the moment it publishes."
    },
    {
      "id": "stands_alone",
      "applies_to": "all",
      "rule": "no field may reference a figure or fact that appears only on another card",
      "why": "People see one post in a feed, not the set."
    },
    {
      "id": "tile_needs_a_sentence",
      "applies_to": ["market-two-figures", "market-one-figure"],
      "rule": "every figure in a stat tile must also appear inside titan_line",
      "why": "A bare stat tile reads as a random number. Every figure is written as a sentence."
    }
  ],

